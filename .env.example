# ---- Aplicação ----
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Audiobook
# Gere com: openssl rand -base64 32
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# E-mails de administradores, separados por virgula (crie a conta normalmente pelo /cadastro)
ADMIN_EMAILS=

# ---- Banco de dados (PostgreSQL) ----
# As tabelas sao criadas automaticamente no "npm run build".
DATABASE_URL=postgres://postgres@localhost:5432/audiobook
# true para provedores que exigem SSL (Supabase, Neon)
DATABASE_SSL=false

# ---- Assinatura ----
PLAN_PRICE=19.90
PLAN_DESCRIPTION=Assinatura mensal - acesso a todo o catalogo
# Dias de tolerancia apos o vencimento antes de bloquear o acesso
GRACE_DAYS=3

# ---- Asaas ----
# Sem ASAAS_API_KEY o app roda em MODO SIMULADO (nenhuma cobranca real).
# Sandbox:  https://api-sandbox.asaas.com/v3
# Producao: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Somente para testes em producao sem Asaas: libera o botao "Simular pagamento".
# NUNCA deixe true com o app aberto ao publico.
ALLOW_SIMULATED_PAYMENTS=false
# Token que voce define ao cadastrar o webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=troque-por-um-token-do-webhook

# ---- Armazenamento dos audios e capas ----
# local = pasta ./storage (desenvolvimento) | s3 = Cloudflare R2, AWS S3 ou similar
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para Supabase Storage
S3_FORCE_PATH_STYLE=false
